# Root .gitignore for Prashant Sinha Systems Portfolio
# Ensures dependencies, build artifacts, local secrets, and AI agent scratch files are never tracked.

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
.turbo/
*/.turbo/

# Testing & Coverage
coverage/
*/coverage/

# Environment Variables & Secrets (Keep .env.example, never commit secrets)
.env*.local
.env
.env.production
.env.development
.env.test
*/.env*.local
*/.env
*/.env.production
*/.env.development
*/.env.test
!.env.example
!*/.env.example
*.pem

# Vercel Deployment Artifacts & CLI State
.vercel/
*/.vercel/

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts
*/next-env.d.ts

# AI Agent & Dev Scratch Files (Auto-generated by next dev or IDEs)
AGENTS.md
CLAUDE.md
*/AGENTS.md
*/CLAUDE.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Directories
.vscode/
*/.vscode/
.idea/
*/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
